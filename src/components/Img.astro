---
import { getImage } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  border?: boolean;
  href?: string | false;
  figcaption?: string;
  figure?: boolean;
}

const { src, alt, border = false, href, figcaption, figure = true } = Astro.props;

// Import all article images using import.meta.glob
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/articles/*.{png,jpg,jpeg,gif,svg,webp}',
);

// Look up the image by filename
const imagePath = `/src/images/articles/${src}`;
const imageModule = images[imagePath];

if (!imageModule) {
  throw new Error(`Image not found: ${src}. Available images: ${Object.keys(images).join(', ')}`);
}

const image = (await imageModule()).default;
const processed = await getImage({ src: image });

// For the link, use the full-size image or explicit href
const linkHref = href === false ? null : (href || processed.src);
---

{figure !== false ? (
  <figure class:list={[{ 'noborder': !border }]}>
    {linkHref ? (
      <a href={linkHref}>
        <img
          src={processed.src}
          srcset={processed.srcSet.attribute}
          alt={alt}
          width={processed.attributes.width}
          height={processed.attributes.height}
        />
      </a>
    ) : (
      <img
        src={processed.src}
        srcset={processed.srcSet.attribute}
        alt={alt}
        width={processed.attributes.width}
        height={processed.attributes.height}
      />
    )}
    {figcaption && <figcaption>{figcaption}</figcaption>}
  </figure>
) : linkHref ? (
  <a href={linkHref}>
    <img
      src={processed.src}
      srcset={processed.srcSet.attribute}
      alt={alt}
      width={processed.attributes.width}
      height={processed.attributes.height}
    />
  </a>
) : (
  <img
    src={processed.src}
    srcset={processed.srcSet.attribute}
    alt={alt}
    width={processed.attributes.width}
    height={processed.attributes.height}
  />
)}
