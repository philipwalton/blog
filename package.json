{
  "name": "blog",
  "version": "4.29.0",
  "description": "The source code for philipwalton.com",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/philipwalton/blog.git"
  },
  "author": {
    "name": "Philip Walton",
    "url": "https://philipwalton.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/philipwalton/blog/issues"
  },
  "scripts": {
    "clean": "node ./tasks/clean.ts",
    "build": "node ./tasks/build.ts",
    "format": "prettier \"**/*.{js,json,ts}\" --write --ignore-path .gitignore",
    "lint": "eslint \"**/*.{js,ts}\" --fix",
    "types:build": "wrangler types",
    "types:check": "tsc --noEmit",
    "types": "run-s types:build types:check",
    "release:major": "npm version major -m 'Release v%s'",
    "release:minor": "npm version minor -m 'Release v%s'",
    "release:patch": "npm version patch -m 'Release v%s'",
    "deploy": "git push --follow-tags && wrangler deploy",
    "start": "run-p build server watch",
    "watch": "node ./tasks/watch.ts",
    "ready": "wait-on http://localhost:3000 && wait-on http://localhost:3001",
    "server": "run-p server:*",
    "server:log": "node test/server.ts",
    "server:worker": "wrangler dev --port=3000 --var ENVIRONMENT:dev",
    "pretest": "run-s clean build",
    "test": "run-p -r server test:suite",
    "test:suite": "run-s ready vitest wdio",
    "posttest": "pkill -f 'npm run server'",
    "vitest": "vitest run",
    "wdio": "wdio run wdio.conf.js",
    "version": "NODE_ENV=production run-s clean types build",
    "postversion": "npm run deploy",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "lint-staged": {
    "**/*.{ts}": "eslint --fix",
    "**/*.{ts,json}": "prettier --write --ignore-path .gitignore",
    "wrangler.toml": "wrangler types"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": false,
    "quoteProps": "preserve",
    "singleQuote": true
  },
  "devDependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/common-tags": "^1.8.4",
    "@types/fs-extra": "^11.0.4",
    "@types/he": "^1.2.3",
    "@types/html-minifier": "^4.0.6",
    "@types/jsesc": "^3.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/nunjucks": "^3.2.6",
    "@types/postcss-import": "^14.0.3",
    "@wdio/cli": "^9.23.0",
    "@wdio/local-runner": "^9.23.0",
    "@wdio/logger": "^9.18.0",
    "@wdio/mocha-framework": "^9.23.0",
    "@wdio/spec-reporter": "^9.20.0",
    "astro": "^5.16.10",
    "caniuse-lite": "^1.0.30001763",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "chromedriver": "^143.0.4",
    "common-tags": "^1.8.2",
    "cssnano": "7.1.2",
    "eslint": "^9.39.2",
    "fs-extra": "^11.3.3",
    "globals": "^17.0.0",
    "globby": "^16.1.0",
    "gzip-size": "^7.0.0",
    "he": "~1.2.0",
    "highlight.js": "^11.11.1",
    "html-minifier": "^4.0.0",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "jsesc": "^3.1.0",
    "lint-staged": "^16.2.7",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "md5": "^2.3.0",
    "mocha": "^11.7.5",
    "moment-timezone": "^0.6.0",
    "npm-run-all": "^4.1.5",
    "nunjucks": "^3.2.4",
    "path": "^0.12.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "rev-hash": "^4.1.0",
    "rev-path": "^3.0.0",
    "rollup": "^4.55.1",
    "sharp": "^0.34.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3",
    "web-vitals": "^5.1.0",
    "webdriverio": "^9.23.0",
    "wrangler": "^4.58.0"
  },
  "overrides": {
    "chokidar": "$chokidar"
  },
  "dependencies": {
    "@shikijs/transformers": "^3.21.0",
    "remark-github-blockquote-alert": "^2.0.1"
  }
}
