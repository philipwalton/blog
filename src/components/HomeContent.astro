---
/**
 * Shared home page content - article list with excerpts.
 * Used by both the full page and the partial.
 */
import {render} from 'astro:content';
import {formatDate, formatDateISO} from '../utils/dates.ts';
import {getSortedArticles} from '../utils/articles.ts';

// Get all articles and sort by date (newest first)
const sortedArticles = await getSortedArticles();

// Render articles to get excerpts from remarkPluginFrontmatter
const articlesWithExcerpts = await Promise.all(
  sortedArticles.map(async (article) => {
    const {remarkPluginFrontmatter} = await render(article);
    return {
      ...article,
      excerpt: (remarkPluginFrontmatter.excerpt as string) || '',
    };
  })
);

function truncateAtWordBoundary(text: string, maxLength: number): string {
  if (text.length <= maxLength) {
    return text;
  }
  const truncated = text.slice(0, maxLength);
  const lastSpace = truncated.lastIndexOf(' ');
  return lastSpace === -1 ? truncated : truncated.slice(0, lastSpace);
}
---

<ul class="ArticleList">
  {articlesWithExcerpts.map((article) => {
    const date = new Date(article.data.date);
    return (
      <li class="ArticleList-item">
        <a href={`/articles/${article.id}/`} class="ArticlePreview">
          <time class="ArticlePreview-date" datetime={formatDateISO(date)}>
            {formatDate(date)}
          </time>
          <h2 class="ArticlePreview-title">{article.data.title}</h2>
          <p class="ArticlePreview-excerpt">
            {truncateAtWordBoundary(article.excerpt, 180)}&hellip;
          </p>
        </a>
      </li>
    );
  })}
</ul>
