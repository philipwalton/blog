---
/**
 * Shared articles list content - grouped by year.
 * Used by both the full page and the partial.
 */
import {formatDate, formatDateISO} from '../utils/dates.ts';
import {getSortedArticles} from '../utils/articles.ts';

// Get all articles and sort by date (newest first)
const sortedArticles = await getSortedArticles();

// Group articles by year
const articlesByYear = sortedArticles.reduce(
  (acc, article) => {
    const year = new Date(article.data.date).getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(article);
    return acc;
  },
  {} as Record<string, typeof sortedArticles>
);

// Get years in descending order
const years = Object.keys(articlesByYear).sort((a, b) => Number(b) - Number(a));
---

{years.map((year) => (
  <>
    <h3>{year}</h3>
    <ul>
      {articlesByYear[year]?.map((article) => {
        const date = new Date(article.data.date);
        return (
          <li>
            <a href={`/articles/${article.id}/`} title={article.data.title}>
              {article.data.title}
            </a>
            {' '}(<time datetime={formatDateISO(date)}>{formatDate(date)}</time>)
          </li>
        );
      })}
    </ul>
  </>
))}
