---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Site {
  title: string;
  titleSuffix: string;
  themeColor: string;
  description: string;
  baseUrl: string;
}

interface Props {
  title?: string;
  description?: string;
  excerpt?: string;
  path?: string;
  type?: string;
  image?: string;
  private?: boolean;
  site: Site;
}

const { title, description, excerpt, path, type, image, private: isPrivate, site } = Astro.props;

// Import all poster images so they're included in the build
const posterImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/images/poster/*.png',
);

// Get the processed image URL if an image path is provided (convert to WebP)
let ogImageUrl: string | undefined;
if (image) {
  const imageModule = posterImages[`/${image}`];
  if (imageModule) {
    const imageData = (await imageModule()).default;
    const webpImage = await getImage({ src: imageData, format: 'webp' });
    ogImageUrl = `${site.baseUrl}${webpImage.src}`;
  }
}

const pageTitle = title ? `${title}${site.titleSuffix}` : site.title;
const pageDescription = excerpt || description || site.description;
---

<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>{pageTitle}</title>

<!-- Track errors -->
<script is:inline>
  self.__e=function f(e){f.q=f.q||[];f.q.push(e)};
  addEventListener('error', self.__e);
  addEventListener('unhandledrejection', self.__e);
</script>

<!-- Generated via: realfavicongenerator.net and modified -->
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Philip Walton" />

<link href="https://feeds.feedburner.com/philipwalton" rel="alternate" title={site.title} type="application/atom+xml">
<meta name="description" content={pageDescription}>

{!isPrivate && path && (
  <>
    <link rel="canonical" href={`${site.baseUrl}${path}`}>
    {type === 'article' && (
      <>
        <meta name="og:title" content={title}>
        <meta name="og:type" content={type}>
        <meta name="og:url" content={`${site.baseUrl}${path}`}>
        {ogImageUrl && excerpt && (
          <>
            <meta name="og:image" content={ogImageUrl}>
            <meta name="og:description" content={excerpt}>
            <meta name="twitter:card" content="summary_large_image">
          </>
        )}
      </>
    )}
  </>
)}
