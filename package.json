{
  "name": "blog",
  "version": "4.29.0",
  "description": "The source code for philipwalton.com",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/philipwalton/blog.git"
  },
  "author": {
    "name": "Philip Walton",
    "url": "https://philipwalton.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/philipwalton/blog/issues"
  },
  "scripts": {
    "build": "astro build",
    "deploy": "git push --follow-tags && wrangler deploy",
    "dev": "run-p dev:astro server:log",
    "dev:astro": "astro dev",
    "format": "prettier \"**/*.{js,json,ts}\" --write --ignore-path .gitignore",
    "lint": "eslint \"**/*.{js,ts}\" --fix",
    "posttest": "pkill -f 'npm run server'",
    "postversion": "npm run deploy",
    "prepare": "husky",
    "pretest": "astro build --mode test",
    "ready": "wait-on http://localhost:3000 && wait-on http://localhost:3001",
    "release:major": "npm version major -m 'Release v%s'",
    "release:minor": "npm version minor -m 'Release v%s'",
    "release:patch": "npm version patch -m 'Release v%s'",
    "server": "run-p server:*",
    "server:log": "node test/server.ts",
    "server:worker": "wrangler dev --port=3000 --var ENVIRONMENT:dev",
    "test": "run-p -r server test:suite",
    "test:e2e": "wdio",
    "test:integration": "vitest run --project integration",
    "test:suite": "run-s test:unit ready test:integration test:e2e",
    "test:unit": "vitest run --project node --project worker --project browser",
    "types": "run-s types:build types:check",
    "types:build": "wrangler types",
    "types:check": "astro check && tsc --noEmit",
    "version": "NODE_ENV=production run-s types build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "lint-staged": {
    "**/*.{ts}": "eslint --fix",
    "**/*.{ts,json}": "prettier --write --ignore-path .gitignore",
    "wrangler.toml": "wrangler types"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": false,
    "quoteProps": "preserve",
    "singleQuote": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.2",
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/vitest-pool-workers": "^0.18.2",
    "@eslint/js": "^9.39.2",
    "@shikijs/transformers": "^4.3.1",
    "@types/fs-extra": "^11.0.4",
    "@vitest/browser-webdriverio": "^4.1.10",
    "@wdio/cli": "^9.23.0",
    "@wdio/local-runner": "^9.23.0",
    "@wdio/mocha-framework": "^9.23.0",
    "@wdio/spec-reporter": "^9.20.0",
    "astro": "^7.0.6",
    "chromedriver": "^143.0.4",
    "eslint": "^9.39.2",
    "fs-extra": "^11.3.3",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "remark-github-blockquote-alert": "^2.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.3",
    "web-vitals": "^5.1.0",
    "webdriverio": "^9.23.0",
    "wrangler": "^4.107.0"
  }
}
