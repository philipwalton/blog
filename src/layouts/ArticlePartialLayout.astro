---
/**
 * Partial layout for articles - outputs just the article content without
 * the full HTML shell, for SPA-style navigation.
 */
import ArticleContent from '../components/ArticleContent.astro';
import {site} from '../config.ts';

interface Props {
  title: string;
  date: Date;
  path: string;
  translations?: Record<string, string> | undefined;
}

const { title, date, path, translations } = Astro.props;

const documentTitle = `${title}${site.titleSuffix}`;
---

<ArticleContent
  title={title}
  date={date}
  path={path}
  translations={translations}
  documentTitle={documentTitle}
>
  <slot />
</ArticleContent>
